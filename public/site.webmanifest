{
  "name": "LabBench — Online Code IDE & Lab Assistant",
  "short_name": "LabBench",
  "description": "A portable online coding workspace with compilers, live previews, saved projects, and an AI teaching assistant.",
  "id": "/",
  "start_url": "https://labbench-woad.vercel.app/?source=pwa",
  "scope": "https://labbench-woad.vercel.app/",
  "lang": "en",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "categories": ["education", "developer"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
